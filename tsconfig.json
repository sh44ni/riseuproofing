{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./website/*"]
    }
  },
  "include": [
    "website/app/**/*.ts",
    "website/app/**/*.tsx",
    "website/components/**/*.ts",
    "website/components/**/*.tsx",
    "website/lib/**/*.ts",
    "website/lib/**/*.tsx",
    "website/types/**/*.ts",
    "website/types/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "crm",
    "backend",
    ".next",
    "website/.next",
    "**/antigravity-awesome-skills/**",
    ".agents"
  ]
}
