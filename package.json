{
  "name": "rise-up-roofing-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Rise Up Roofing & Construction - Monorepo (Website, CRM & FastAPI Backend)",
  "workspaces": [
    "website",
    "crm"
  ],
  "scripts": {
    "dev:website": "npm --prefix website run dev",
    "dev:crm": "npm --prefix crm run dev",
    "dev:backend": "powershell -Command \"cd backend; .\\.venv\\Scripts\\uvicorn.exe app.main:app --host 127.0.0.1 --port 8000\"",
    "build:website": "npm --prefix website run build",
    "build:crm": "npm --prefix crm run build",
    "build": "npm run build:website",
    "build:all": "npm run build:website && npm run build:crm",
    "start:website": "npm --prefix website run start",
    "preview:crm": "npm --prefix crm run preview"
  }
}
